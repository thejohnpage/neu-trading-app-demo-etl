# OLTP runs on the Neueda Windows VM. Replace WINDOWS_VM_IP with its address reachable from Linux.
OLTP_DSN=postgresql://trading_demo:trading_demo_change_me@WINDOWS_VM_IP:5432/trading_demo

# Warehouse PostgreSQL runs as a separate Linux container exposed on 55433.
WAREHOUSE_DSN=postgresql://trading_dw:trading_dw_change_me@10.14.132.8:55433/trading_dw

ETL_INTERVAL_SECONDS=60
ETL_BATCH_SIZE=500
